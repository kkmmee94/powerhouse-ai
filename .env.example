POWERHOUSE_MODEL_BASE_URL=http://127.0.0.1:8080/v1
POWERHOUSE_MODEL_NAME=local-model
POWERHOUSE_MODEL_API_KEY=local
POWERHOUSE_DATABASE_PATH=data/powerhouse.db
POWERHOUSE_MODE=adaptive
POWERHOUSE_CONTEXT_TOKENS=8192
POWERHOUSE_MAX_OUTPUT_TOKENS=4096
POWERHOUSE_VRAM_LIMIT_MB=15872
POWERHOUSE_REQUEST_TIMEOUT_SECONDS=600
POWERHOUSE_MODEL_ENABLE_THINKING=false
POWERHOUSE_ENABLE_PYTHON_TOOL=false
